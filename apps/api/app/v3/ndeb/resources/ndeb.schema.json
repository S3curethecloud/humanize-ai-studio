        },
        "artifact_refs": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/IdentifierString"
          },
          "$comment": "Normative order key and duplicate key: artifact_id string after NFC normalization."
        },
        "material": {
          "$ref": "#/$defs/AgentCatalogMaterial"
        }
      },
      "required": [
        "evidence_id",
        "record_type",
        "record_id",
        "record_version",
        "source_ref",
        "classification",
        "provenance_refs",
        "artifact_refs",
        "material"
      ],
      "additionalProperties": false,
      "$comment": "evidence_id is globally unique across all nine evidence families by normative semantics."
    },
    "ToolCatalogMaterial": {
