{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nexus:ndeb:schema:1.0.0",
  "title": "NEXUS Delivery Evidence Bundle (NDEB) v1",
  "description": "Canonical public NDEB schema-definition contract. Cross-item ordering, identity uniqueness, referential closure, temporal comparison, NFC normalization, and future digest equality are normative semantics documented in NDEB_SCHEMA_V1_SEMANTICS.md and are not implemented as a runtime validator by this slice.",
  "type": "object",
  "properties": {
    "schema_id": {
      "type": "string",
      "const": "urn:nexus:ndeb"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^ndeb:sha256:[0-9a-f]{64}$"
    },
    "tenant_id": {
      "$ref": "#/$defs/IdentifierString"
    },
    "engagement_id": {
      "$ref": "#/$defs/IdentifierString"
    },
    "approved_snapshot": {
      "$ref": "#/$defs/ApprovedSnapshot"
    },
    "classification": {
      "$ref": "#/$defs/Classification"
    },
    "evidence_manifest": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/EvidenceManifestEntry"
      },
      "$comment": "Normative order key and duplicate key: evidence_id after NFC normalization."
    },
    "evidence": {
      "$ref": "#/$defs/EvidenceFamilies"
    },
    "artifacts": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ArtifactIdentity"
      },
      "$comment": "Normative order key and duplicate key: artifact_id after NFC normalization."
    },
    "provenance": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ProvenanceEntry"
      },
      "$comment": "Normative order key and duplicate key: provenance_id after NFC normalization."
    },
    "approvals": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ApprovalReference"
      },
      "$comment": "Normative order key and duplicate key: approval_id after NFC normalization."
    },
    "required_extensions": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ExtensionName"
      },
      "$comment": "Normative order key and duplicate key: extension name after NFC normalization."
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/ExtensionName"
      },
      "additionalProperties": {
        "type": "object"
      },
      "$comment": "Every required_extensions name resolves to an exact key in this object by normative semantics. Extension payloads are non-null JSON objects."
    },
    "integrity": {
      "$ref": "#/$defs/Integrity"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "bundle_id",
    "tenant_id",
    "engagement_id",
    "approved_snapshot",
    "classification",
    "evidence_manifest",
    "evidence",
    "artifacts",
    "provenance",
    "approvals",
    "required_extensions",
    "extensions",
    "integrity"
  ],
  "additionalProperties": false,
  "$defs": {
    "IdentifierString": {
      "type": "string",
      "minLength": 1
    },
    "TokenString": {
      "type": "string",
      "minLength": 1
    },
    "NarrativeString": {
      "type": "string",
      "minLength": 1
    },
    "TimestampUTC": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "NonNegativeInt": {
      "type": "integer",
      "minimum": 0
    },
    "PositiveInt": {
      "type": "integer",
      "minimum": 1
    },
    "ExtensionName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)+/[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
      "$comment": "Lexical v1 form for <reverse-dns-namespace>/<extension-name>."
    },
    "SourceReference": {
      "type": "object",
      "properties": {
        "object_type": {
          "$ref": "#/$defs/TokenString"
        },
        "object_id": {
          "$ref": "#/$defs/IdentifierString"
        },
        "object_version": {
          "$ref": "#/$defs/PositiveInt"
        },
        "relation": {
          "$ref": "#/$defs/TokenString"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version"
      ],
      "additionalProperties": false
    },
    "RevisionReference": {
      "type": "object",
      "properties": {
        "authority": {
          "type": "string",
          "const": "nexus"
        },
        "revision_type": {
          "$ref": "#/$defs/TokenString"
        },
        "revision_id": {
          "$ref": "#/$defs/IdentifierString"
        }
      },
      "required": [
        "authority",
        "revision_type",
        "revision_id"
      ],
      "additionalProperties": false
    },
    "SubjectReference": {
      "type": "object",
      "properties": {
        "subject_type": {
          "type": "string",
          "enum": [
            "evidence",
            "artifact",
            "approval",
            "approved_snapshot"
          ]
        },
        "subject_id": {
          "$ref": "#/$defs/IdentifierString"
        }
      },
      "required": [
        "subject_type",
        "subject_id"
      ],
      "additionalProperties": false
    },
    "Classification": {
      "type": "object",
      "properties": {
        "value": {
          "$ref": "#/$defs/TokenString"
        },
        "authority_ref": {
          "$ref": "#/$defs/SourceReference"
        }
      },
      "required": [
        "value",
        "authority_ref"
      ],
      "additionalProperties": false,
      "$comment": "Missing, ambiguous, unsupported-required, or downgraded classification fails closed by normative semantics."
    },
    "ApprovedSnapshot": {
      "type": "object",
      "properties": {
        "snapshot_id": {
          "$ref": "#/$defs/IdentifierString"
        },
        "source_state_revision": {
          "$ref": "#/$defs/RevisionReference"
        },
        "captured_at": {
          "$ref": "#/$defs/TimestampUTC"
        },
        "approved_at": {
          "$ref": "#/$defs/TimestampUTC"
        },
        "approval_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/IdentifierString"
          },
          "$comment": "Normative order key and duplicate key: approval_id string after NFC normalization."
        }
      },
      "required": [
        "snapshot_id",
        "source_state_revision",
        "captured_at",
        "approved_at",
        "approval_refs"
      ],
      "additionalProperties": false,
      "$comment": "Normative semantic rule captured_at <= approved_at; each approval_refs value resolves to exactly one approvals[].approval_id."
    },
    "ArchitectureDecisionMaterial": {
      "type": "object",
      "properties": {
        "title": {
          "$ref": "#/$defs/NarrativeString"
        },
        "decision": {
          "$ref": "#/$defs/NarrativeString"
        },
        "rationale": {
          "$ref": "#/$defs/NarrativeString"
        },
        "status": {
          "$ref": "#/$defs/TokenString"
        }
      },
      "required": [
        "title",
        "decision",
        "rationale",
        "status"
      ],
      "additionalProperties": false
    },
    "ArchitectureDecisionsEvidenceItem": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/IdentifierString"
        },
        "record_type": {
          "type": "string",
          "const": "architecture_decision"
        },
        "record_id": {
          "$ref": "#/$defs/IdentifierString"
        },
        "record_version": {
          "$ref": "#/$defs/PositiveInt"
        },
        "source_ref": {
          "$ref": "#/$defs/SourceReference"
        },
        "classification": {
          "$ref": "#/$defs/Classification"
        },
        "provenance_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/IdentifierString"
          },
          "$comment": "Normative order key and duplicate key: provenance_id string after NFC normalization."
        },
        "artifact_refs": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/IdentifierString"
          },
          "$comment": "Normative order key and duplicate key: artifact_id string after NFC normalization."
        },
        "material": {
          "$ref": "#/$defs/ArchitectureDecisionMaterial"
        }
      },
      "required": [
        "evidence_id",
        "record_type",
        "record_id",
        "record_version",
        "source_ref",
        "classification",
        "provenance_refs",
        "artifact_refs",
        "material"
      ],
      "additionalProperties": false,
      "$comment": "evidence_id is globally unique across all nine evidence families by normative semantics."
    },
    "AgentCatalogMaterial": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/NarrativeString"
        },
        "purpose": {
          "$ref": "#/$defs/NarrativeString"
