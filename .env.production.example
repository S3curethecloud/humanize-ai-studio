# API network binding
API_HOST=0.0.0.0
API_PORT=8000

# Supported values:
# deterministic
# cloudflare
HUMANIZE_REWRITE_PROVIDER=deterministic

# Cloudflare Workers AI
# Required when HUMANIZE_REWRITE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/openai/gpt-oss-20b
CLOUDFLARE_AI_TIMEOUT_SECONDS=30
CLOUDFLARE_AI_FALLBACK_ENABLED=true

# Published frontend port
WEB_PORT=8080
